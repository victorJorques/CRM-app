# ---------------------------------------------------------------------------
# Copia este fichero a .env y rellena solo lo que vayas a usar.
# Conserje arranca sin ninguna de estas lineas: el panel y el cerebro de
# reglas funcionan tal cual. Cada bloque enciende un canal mas.
# ---------------------------------------------------------------------------

# Clave del panel. Si la dejas vacia, el panel solo acepta conexiones desde
# este mismo ordenador y avisa de ello al arrancar.
CONSERJE_CLAVE=

# Semilla para firmar las sesiones del panel. Si no la pones, se genera una
# al vuelo y se cierran las sesiones cada vez que reinicias.
CONSERJE_SECRETO=

# Puerto del panel.
CONSERJE_PUERTO=4180

# --- Cerebro con Claude (opcional) -----------------------------------------
# Sin esta clave contesta el cerebro de reglas: entiende menos frases raras,
# pero coge citas, las mueve y las anula igual.
ANTHROPIC_API_KEY=

# --- WhatsApp (opcional) ---------------------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_ID_NUMERO=
WHATSAPP_VERIFICACION=
WHATSAPP_SECRETO_APP=

# --- Correo (opcional) -----------------------------------------------------
CORREO_USUARIO=
CORREO_CLAVE_APLICACION=
CORREO_SMTP=smtp.gmail.com
CORREO_SMTP_PUERTO=465
CORREO_IMAP=imap.gmail.com
CORREO_IMAP_PUERTO=993

# --- Llamadas (opcional) ---------------------------------------------------
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_NUMERO=
CONSERJE_URL_PUBLICA=
